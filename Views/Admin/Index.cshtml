@{
    ViewData["Title"] = "Bảng điều khiển";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    /* ===== RESET & BASE ===== */
    body {
        background-color: #f0f2f5;
        font-family: 'Segoe UI', sans-serif;
    }

    /* ===== TOPBAR ===== */
    .topbar {
        background: #fff;
        border-bottom: 1px solid #e8eaed;
        padding: 14px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .topbar-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .topbar-title .page-icon {
        width: 38px;
        height: 38px;
        background: #f0f2f5;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        font-size: 1.1rem;
    }

    .topbar-title h1 {
        font-size: 1.25rem;
        font-weight: 700;
        color: #1a1d23;
        margin: 0;
    }

    .topbar-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .topbar-right .welcome-text {
        font-size: 0.88rem;
        color: #555;
        margin-right: 8px;
    }

    .topbar-right .welcome-text strong {
        color: #1a1d23;
    }

    .topbar-btn {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        border: 1.5px solid #e0e3e8;
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #555;
        cursor: pointer;
        transition: background 0.2s;
        font-size: 1rem;
    }

    .topbar-btn:hover {
        background: #f0f2f5;
    }

    /* ===== STAT CARDS (TOP ROW) ===== */
    .stat-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: #fff;
        border-radius: 14px;
        padding: 22px 24px;
        display: flex;
        align-items: center;
        gap: 18px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.05);
        border: 1px solid #eef0f3;
        transition: box-shadow 0.2s;
    }

    .stat-card:hover {
        box-shadow: 0 4px 16px rgba(0,0,0,0.09);
    }

    .stat-icon-wrap {
        width: 64px;
        height: 64px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .stat-icon-wrap img,
    .stat-icon-wrap i {
        font-size: 1.9rem;
    }

    .stat-icon-wrap.red    { background: #fff0ee; color: #e8462a; }
    .stat-icon-wrap.blue   { background: #eef4ff; color: #3b7fef; }
    .stat-icon-wrap.yellow { background: #fffbe6; color: #d4a017; }

    .stat-info .value {
        font-size: 2rem;
        font-weight: 800;
        color: #1a1d23;
        line-height: 1.1;
    }

    .stat-info .label {
        font-size: 0.92rem;
        color: #737b8b;
        margin-top: 2px;
    }

    .stat-info .sub {
        font-size: 0.8rem;
        color: #22a55b;
        margin-top: 6px;
        font-weight: 500;
    }

    .stat-info .sub.neutral {
        color: #22a55b;
    }

    /* ===== QUICK ACCESS CARDS ===== */
    .quick-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 20px;
    }

    .quick-card {
        background: #fff;
        border-radius: 14px;
        padding: 22px 24px;
        border: 1px solid #eef0f3;
        box-shadow: 0 1px 6px rgba(0,0,0,0.05);
        transition: box-shadow 0.2s;
    }

    .quick-card:hover {
        box-shadow: 0 4px 16px rgba(0,0,0,0.09);
    }

    .quick-card-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
    }

    .quick-icon-wrap {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }

    .quick-icon-wrap.red    { background: #fff0ee; color: #e8462a; }
    .quick-icon-wrap.blue   { background: #eef4ff; color: #3b7fef; }
    .quick-icon-wrap.yellow { background: #fffbe6; color: #d4a017; }

    .quick-card-header h6 {
        font-size: 1rem;
        font-weight: 700;
        color: #1a1d23;
        margin: 0;
    }

    .quick-card p {
        font-size: 0.83rem;
        color: #737b8b;
        line-height: 1.55;
        margin-bottom: 16px;
        min-height: 42px;
    }

    .btn-quick {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 9px 18px;
        border-radius: 8px;
        font-size: 0.85rem;
        font-weight: 600;
        border: none;
        cursor: pointer;
        text-decoration: none;
        transition: opacity 0.15s, transform 0.15s;
    }

    .btn-quick:hover {
        opacity: 0.87;
        transform: translateX(2px);
    }

    .btn-quick.red    { background: #e8462a; color: #fff; }
    .btn-quick.blue   { background: #3b7fef; color: #fff; }
    .btn-quick.yellow { background: #f5c518; color: #1a1d23; }

    /* ===== ACTIVITY PANEL ===== */
    .activity-card {
        background: #fff;
        border-radius: 14px;
        padding: 24px;
        border: 1px solid #eef0f3;
        box-shadow: 0 1px 6px rgba(0,0,0,0.05);
    }

    .activity-card h5 {
        font-size: 1.05rem;
        font-weight: 700;
        color: #1a1d23;
        margin-bottom: 18px;
    }

    .activity-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .activity-item {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        padding-bottom: 14px;
        border-bottom: 1px solid #f3f4f6;
    }

    .activity-item:last-child {
        border-bottom: none;
        padding-bottom: 0;
    }

    .activity-icon {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 0.95rem;
    }

    .activity-icon.person { background: #eef4ff; color: #3b7fef; }
    .activity-icon.calendar { background: #fffbe6; color: #d4a017; }

    .activity-text {
        font-size: 0.87rem;
        color: #3a3f4b;
        line-height: 1.5;
    }
</style>

    <!-- MAIN CONTENT -->
    <div class="p-4">

        <!-- STAT CARDS -->
        <div class="stat-row">
