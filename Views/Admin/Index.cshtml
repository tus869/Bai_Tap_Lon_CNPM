<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-4">
        <div class="d-flex align-items-center mb-3">
            <div class="bg-info bg-opacity-10 text-info rounded-circle d-flex justify-content-center align-items-center me-3" style="width: 50px; height: 50px; font-size: 1.5rem;">
