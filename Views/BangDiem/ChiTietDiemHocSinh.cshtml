@model IEnumerable<CNPM.Models.BangDiem>
@{
    ViewData["Title"] = "Chi tiết điểm Học sinh";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var hs = ViewBag.HocSinhInfo as CNPM.Models.HocSinh;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-bold text-dark mb-1">BẢNG ĐIỂM CÁ NHÂN</h3>
            <p class="text-muted">Học sinh: <strong class="text-primary">@hs.HoTen</strong> | Lớp: <strong>@hs.LopHoc?.TenLop</strong></p>
        </div>
        <a href="javascript:history.back()" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left"></i> Trở về</a>
    </div>

    <table class="table table-bordered table-hover text-center bg-white shadow-sm">
        <thead class="bg-primary text-white">
            <tr>
                <th>Học kỳ</th>
                <th>Môn học</th>
                <th>Miệng</th>
                <th>15P</th>
                <th>1 Tiết</th>
                <th>Thi</th>
                <th>ĐTB Môn</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.HocKy</td>
                    <td>@item.MonHoc.TenMon</td>
                    <td>@item.DiemMieng</td>
                    <td>@item.Diem15P</td>
                    <td>@item.Diem45P</td>
                    <td class="fw-bold">@item.DiemThi</td>
                    <td class="fw-bold text-danger">@item.DiemTrungBinh</td>
                </tr>
            }
        </tbody>
    </table>
</div>