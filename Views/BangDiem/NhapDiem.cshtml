@{
    ViewData["Title"] = "Nhập Điểm Học Sinh";
    // 1. CHỈ ĐỊNH DÙNG LAYOUT CỦA GIÁO VIÊN
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4 rounded-3" role="alert">
                <i class="fa-solid fa-circle-check me-2 fs-5"></i> <strong>Tuyệt vời!</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (ViewBag.CustomError != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4 rounded-3" role="alert">
                <i class="fa-solid fa-triangle-exclamation me-2 fs-5"></i> <strong>Gửi thất bại:</strong> @ViewBag.CustomError
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <div>
            <h3 class="fw-bold text-primary mb-1 text-uppercase">
                <i class="fa-solid fa-pen-to-square me-2"></i> NHẬP ĐIỂM HỌC SINH
            </h3>
            <p class="text-muted mb-0">Cập nhật điểm số thường xuyên, giữa kỳ và cuối kỳ (Chờ Admin duyệt).</p>
        </div>
        <a href="/Teacher/Index" class="btn btn-outline-secondary rounded-pill px-4 fw-bold shadow-sm">
            <i class="fa-solid fa-arrow-left me-2"></i> Quay lại
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4 p-md-5">
            <form asp-action="NhapDiem" method="post" class="needs-validation" novalidate>

                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">1. THÔNG TIN CHUNG</h5>
                <div class="row g-4 mb-5">
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted">Học kỳ <span class="text-danger">*</span></label>
                        <select name="HocKy" class="form-select form-select-lg rounded-3 bg-light border-0" required>
                            <!-- SỬA Ở ĐÂY: Đổi value thành số 1 và 2 -->
                            <option value="1">Học kỳ 1</option>
                            <option value="2">Học kỳ 2</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted">Chọn Học sinh <span class="text-danger">*</span></label>
                        <!-- SỬA Ở ĐÂY: Xóa bớt 1 dấu < bị thừa ở đầu chữ select -->
                        <select name="MaHS" class="form-select form-select-lg rounded-3 bg-light border-0" asp-items="@ViewBag.DanhSachHocSinh" required>
                            <option value="">-- Vui lòng chọn Học sinh --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-muted">Chọn Môn học <span class="text-danger">*</span></label>
                        <select name="MaMon" class="form-select form-select-lg rounded-3 bg-light border-0" asp-items="@ViewBag.DanhSachMonHoc" required>
                            <option value="">-- Vui lòng chọn Môn học --</option>
                        </select>
                    </div>
                </div>

                <h5 class="fw-bold text-dark mb-4 border-bottom pb-2">2. ĐIỂM THÀNH PHẦN</h5>
                <div class="row g-4 mb-4">
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-muted">Điểm Miệng (Hệ số 1)</label>
                        <input type="number" step="0.1" min="0" max="10" name="DiemMieng" class="form-control form-control-lg rounded-3 border-primary border-opacity-25" placeholder="Ví dụ: 8.5" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-muted">Điểm 15 Phút (Hệ số 1)</label>
                        <input type="number" step="0.1" min="0" max="10" name="Diem15P" class="form-control form-control-lg rounded-3 border-primary border-opacity-25" placeholder="Ví dụ: 9.0" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-muted">Điểm 1 Tiết (Hệ số 2)</label>
                        <input type="number" step="0.1" min="0" max="10" name="Diem45P" class="form-control form-control-lg rounded-3 border-primary border-opacity-25" placeholder="Ví dụ: 7.5" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-muted">Điểm Thi (Hệ số 3) <span class="text-danger">*</span></label>
                        <input type="number" step="0.1" min="0" max="10" name="DiemThi" class="form-control form-control-lg rounded-3 border-danger border-opacity-50" required placeholder="Ví dụ: 8.0" />
                    </div>
                </div>

                <div class="text-end mt-5">
                    <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold shadow">
                        <i class="fa-solid fa-paper-plane me-2"></i> GỬI LÊN ADMIN DUYỆT
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>