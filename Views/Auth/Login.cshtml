@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - THPT Mường Ảng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body, html { height: 100%; margin: 0; background-color: #ffffff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        
        /* Chia đôi màn hình */
        .auth-container { display: flex; height: 100vh; }
        .auth-left { flex: 1; background: #fcece0; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative; }
        .auth-right { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px; background: white; }
        
        /* Ảnh nền bên trái (Đọc từ thư mục images) */
        .auth-left img { width: 100%; height: 100%; object-fit: cover; }

        /* Form bên phải */
        .form-wrapper { width: 100%; max-width: 420px; }
        
        .auth-logo { font-size: 2.5rem; color: #4a2842; margin-bottom: 10px; display: flex; justify-content: center; }
        .auth-title { font-weight: 700; font-size: 1.5rem; color: #333; margin-bottom: 5px; text-align: center; }
        .auth-subtitle { color: #888; font-size: 0.85rem; margin-bottom: 30px; text-align: center; }

        /* Nút Google */
        .btn-google {
            background: white; border: 1px solid #e2e8f0; color: #555; font-weight: 500; font-size: 0.9rem;
            width: 100%; padding: 10px; border-radius: 6px; display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 25px; transition: all 0.2s;
        }
        .btn-google:hover { background: #f8f9fa; }
        .btn-google img { width: 18px; }

        /* Dòng chia "Hoặc" */
        .divider { display: flex; align-items: center; text-align: center; color: #adb5bd; font-size: 0.75rem; margin-bottom: 25px; }
        .divider::before, .divider::after { content: ''; flex: 1; border-bottom: 1px dashed #e2e8f0; }
        .divider:not(:empty)::before { margin-right: .5em; }
        .divider:not(:empty)::after { margin-left: .5em; }

        /* Các ô Input */
        .form-label { font-size: 0.8rem; color: #666; font-weight: 500; margin-bottom: 5px; }
        .form-control { padding: 12px 15px; font-size: 0.9rem; border-radius: 6px; border: 1px solid #e2e8f0; }
        .form-control:focus { border-color: #812f5a; box-shadow: 0 0 0 0.2rem rgba(129, 47, 90, 0.15); }

        /* Các link phụ */
        .auth-options { display: flex; justify-content: space-between; align-items: center; font-size: 0.75rem; margin-bottom: 20px; }
        .auth-options a { color: #812f5a; text-decoration: none; }
        .auth-options a:hover { text-decoration: underline; }
        .form-check-label { color: #666; }

        /* Nút Submit đỏ mận */
        .btn-primary-custom { background-color: #812f5a; border: none; color: white; padding: 12px; font-weight: 600; border-radius: 6px; transition: all 0.3s; }
        .btn-primary-custom:hover { background-color: #612243; color: white; }

        .auth-footer { margin-top: 40px; text-align: center; font-size: 0.85rem; color: #888; }
        .auth-footer a { color: #812f5a; font-weight: 600; text-decoration: none; }

        @@media (max-width: 768px) {
            .auth-left { display: none; } /* Ẩn ảnh bên trái khi dùng điện thoại */
        }
    </style>
</head>
<body>

    <div class="auth-container">
        <div class="auth-left">
            <img src="/images/banners/auth-bg.png" alt="Auth Background" onerror="this.style.display='none'">
        </div>

        <div class="auth-right">
            <div class="form-wrapper">
                
                <div class="auth-logo">
                    <i class="fa-solid fa-compress"></i>
                </div>
                <h2 class="auth-title">Đăng nhập tài khoản của bạn</h2>
                <p class="auth-subtitle">Điền thông tin để bắt đầu</p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center py-2 small">@ViewBag.Error</div>
                }

                <button class="btn-google">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google"> Tiếp tục với Google
                </button>

                <div class="divider">Hoặc đăng nhập với Email</div>

                <form asp-controller="Auth" asp-action="Login" method="post">
                    <div class="mb-3">
                        <label class="form-label">Email / Tài khoản</label>
                        <input type="text" class="form-control" name="username" placeholder="mail@abc.com" required autofocus />
                    </div>
                    
                    <div class="mb-3">
                        <label class="form-label">Mật khẩu</label>
                        <input type="password" class="form-control" name="password" placeholder="••••••••••••" required />
                    </div>

                    <div class="auth-options">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberMe">
                            <label class="form-check-label" for="rememberMe">Ghi nhớ</label>
                        </div>
                        <a href="#">Quên mật khẩu?</a>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100">Đăng nhập</button>
                </form>

                <div class="auth-footer">
                    Chưa có tài khoản? <a href="/Auth/Register">Tạo tài khoản mới</a>
                </div>

            </div>
        </div>
    </div>

</body>
</html>