@{
    Layout = null; 
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng ký - THPT Mường Ảng</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body, html { height: 100%; margin: 0; background-color: #ffffff; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
        
        .auth-container { display: flex; height: 100vh; }
        .auth-left { flex: 1; background: #fcece0; display: flex; align-items: center; justify-content: center; overflow: hidden; position: fixed; width: 50%; height: 100%; left: 0; }
        .auth-right { flex: 1; display: flex; flex-direction: column; align-items: center; padding: 40px 20px; background: white; margin-left: 50%; min-height: 100vh; justify-content: center;}
        
        .auth-left img { width: 100%; height: 100%; object-fit: cover; }

        .form-wrapper { width: 100%; max-width: 480px; }
        
        .auth-logo { font-size: 2.5rem; color: #4a2842; margin-bottom: 5px; display: flex; justify-content: center; }
        .auth-title { font-weight: 700; font-size: 1.5rem; color: #333; margin-bottom: 5px; text-align: center; }
        .auth-subtitle { color: #888; font-size: 0.85rem; margin-bottom: 30px; text-align: center; }

        .form-label { font-size: 0.75rem; color: #666; font-weight: 500; margin-bottom: 4px; }
        .form-control, .form-select { padding: 10px 15px; font-size: 0.85rem; border-radius: 6px; border: 1px solid #e2e8f0; color: #555; }
        .form-control:focus, .form-select:focus { border-color: #812f5a; box-shadow: 0 0 0 0.2rem rgba(129, 47, 90, 0.15); }
        
        .input-group-text { background: transparent; border-left: none; color: #888; border-color: #e2e8f0; cursor: pointer; }
        .form-control.border-end-0 { border-right: none; }

        .radio-group { display: flex; gap: 20px; font-size: 0.85rem; color: #555; padding-top: 5px; }
        .form-check-input:checked { background-color: #812f5a; border-color: #812f5a; }

        .btn-primary-custom { background-color: #812f5a; border: none; color: white; padding: 12px; font-weight: 600; border-radius: 6px; transition: all 0.3s; margin-top: 10px; }
        .btn-primary-custom:hover { background-color: #612243; color: white; }

        .auth-footer { margin-top: 25px; text-align: center; font-size: 0.85rem; color: #888; }
        .auth-footer a { color: #812f5a; font-weight: 600; text-decoration: none; }

        @@media (max-width: 768px) {
            .auth-left { display: none; }
            .auth-right { margin-left: 0; width: 100%; }
        }
    </style>
</head>
<body>

    <div class="auth-container">
        <div class="auth-left">
            <img src="/images/banners/auth-bg.png" alt="Auth Background" onerror="this.style.display='none'">
        </div>

        <div class="auth-right">
            <div class="form-wrapper">
                
                <div class="auth-logo">
                    <i class="fa-solid fa-compress"></i>
                </div>
                <h2 class="auth-title">Đăng ký tài khoản của bạn</h2>
                <p class="auth-subtitle">Điền thông tin chi tiết của bạn để bắt đầu</p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center py-2 small">@ViewBag.Error</div>
                }

                <form asp-controller="Auth" asp-action="Register" method="post">
                    
                    <div class="mb-3">
                        <label class="form-label">Tên truy cập (Tài khoản)</label>
                        <input type="text" class="form-control" name="username" placeholder="Tên của bạn" required autofocus />
                    </div>

                    <div class="row mb-3 g-2">
                        <div class="col-md-6">
                            <label class="form-label">Họ</label>
                            <input type="text" class="form-control" placeholder="Họ" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tên</label>
                            <input type="text" class="form-control" placeholder="Tên" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Họ tên đầy đủ</label>
                        <input type="text" class="form-control" placeholder="Nguyễn Văn A" />
                    </div>

                    <div class="row mb-3 g-2">
                        <div class="col-4">
                            <label class="form-label">Ngày sinh:</label>
                            <input type="text" class="form-control" placeholder="DD" />
                        </div>
                        <div class="col-4">
                            <label class="form-label">Tháng</label>
                            <input type="text" class="form-control" placeholder="MM" />
                        </div>
                        <div class="col-4">
                            <label class="form-label">Năm</label>
                            <input type="text" class="form-control" placeholder="YYYY" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Giới tính:</label>
                        <div class="radio-group">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="gender" id="gNam" checked>
                                <label class="form-check-label" for="gNam">Nam</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="gender" id="gNu">
                                <label class="form-check-label" for="gNu">Nữ</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="gender" id="gKhac">
                                <label class="form-check-label" for="gKhac">Khác</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Số điện thoại hoặc Email</label>
                        <input type="text" class="form-control" placeholder="0123456789 Hoặc nguyenvan@gmail.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Mật khẩu</label>
                        <div class="input-group">
                            <input type="password" class="form-control border-end-0" name="password" placeholder="••••••••••••" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Nhập lại mật khẩu</label>
                        <div class="input-group">
                            <input type="password" class="form-control border-end-0" name="confirmPassword" placeholder="••••••••••••" required />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary-custom w-100">Đăng ký</button>
                </form>

                <div class="auth-footer">
                    Đã có tài khoản? <a href="/Auth/Login">Đăng nhập</a>
                </div>

            </div>
        </div>
    </div>

</body>
</html>